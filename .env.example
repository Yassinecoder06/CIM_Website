# Deploy the Google Apps Script Web App and paste its /exec URL here.
VITE_REGISTRATION_ENDPOINT=
# Comma-separated trusted origins allowed to message the form iframe.
VITE_REGISTRATION_ALLOWED_ORIGINS=https://script.google.com,https://script.googleusercontent.com
# Optional — links remain hidden until set.
VITE_FACEBOOK_URL=
VITE_LINKEDIN_URL=
